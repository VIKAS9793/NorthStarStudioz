# HTTP response headers, applied by Cloudflare Pages.
# The <meta> Content-Security-Policy in each page stays the source of truth;
# frame-ancestors can only be set here.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin

# Caching. File names are not content-hashed, so only files that never change
# under the same name are cached "forever"; scripts and styles revalidate.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/brand/*
  Cache-Control: public, max-age=604800
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
